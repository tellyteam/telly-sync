{
  "name": "telly-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // No request logs, traces or analytics: the relay keeps nothing about who used it.
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } },
  "workers_dev": true,
  "preview_urls": false,
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telly-sync",
      // telly's own database. Running your own? Replace it with the id `npx wrangler d1 create telly-sync` prints.
      "database_id": "22aa0209-8de0-4e81-8946-9ef89187ca04",
      "migrations_dir": "migrations"
    }
  ]
}
